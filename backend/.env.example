# Set to true to log request timing ([dashboard], [admin-pickups], etc.)
# DEBUG_PERFORMANCE=true

# MongoDB
MONGODB_URI=

# Auth / JWT (existing — keep your current values)
JWT_SECRET=

# Razorpay Standard Checkout + wallet recharge (Dashboard → API Keys; use Test in dev)
# Never commit real keys. Copy to backend/.env locally.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook signing secret (Dashboard → Webhooks) for POST /api/wallet/razorpay/webhook
RAZORPAY_WEBHOOK_SECRET=

# MSG91 WhatsApp (backend only; keep MSG91_ENABLED=false until templates are approved)
MSG91_AUTH_KEY=
MSG91_API_URL=https://api.msg91.com/api/v5/whatsapp/whatsapp-outbound-message/bulk/
MSG91_INTEGRATED_NUMBER=917827979505
MSG91_ENABLED=false
# Optional: override recipient for safe testing (10-digit Indian mobile); leave empty in production
MSG91_TEST_RECIPIENT=
# Pending send lock older than this (ms) can be retried after a crash; default 300000 (5 min)
MSG91_PENDING_STALE_MS=

# Delhivery (Phase 1: pincode serviceability + expected TAT only)
DELHIVERY_ENV=staging
DELHIVERY_BASE_URL=https://staging-express.delhivery.com
DELHIVERY_API_TOKEN=
# 6-digit warehouse/origin pin for Expected TAT (falls back to company zip_code if unset)
DELHIVERY_ORIGIN_PIN=
# Set false to keep COD order creation unchanged while testing Delhivery APIs manually
DELHIVERY_COD_CHECK_ENABLED=true
DELHIVERY_REQUEST_TIMEOUT_MS=15000
# Set true only after staging confirms each MPS package needs its own cancellation request
DELHIVERY_MPS_CANCEL_INDIVIDUAL=false

# Delhivery FM pickup request (assumed slot policy — confirm with Delhivery POC)
DELHIVERY_PICKUP_TIME=11:00:00
DELHIVERY_PICKUP_TIMEZONE=Asia/Kolkata
# IST cutoff: at/after this time the default pickup date becomes tomorrow (default 6:00 PM)
DELHIVERY_PICKUP_DATE_CUTOFF=18:00:00
DELHIVERY_PICKUP_WORKER_ENABLED=true
# Poll Delhivery packages/json for shipments already marked Shipped in Aaysh (no Trackon orders)
DELHIVERY_TRACKING_WORKER_ENABLED=true
DELHIVERY_TRACKING_POLL_INTERVAL_MS=1200000
DELHIVERY_TRACKING_BATCH_SIZE=40
DELHIVERY_TRACKING_CLAIM_TTL_MS=240000

# Trackon forward shipment tracking (disabled by default; poll after Aaysh status is Shipped)
TRACKON_TRACKING_ENABLED=false
TRACKON_TRACKING_BASE_URL=https://api.trackon.in
TRACKON_APP_KEY=
TRACKON_USER_ID=
TRACKON_PASSWORD=
TRACKON_TRACKING_POLL_INTERVAL_MS=1200000
TRACKON_TRACKING_BATCH_SIZE=40
TRACKON_TRACKING_CLAIM_TTL_MS=240000

# B2C (default) or Heavy — selects ONE serviceability API for COD precheck
DELHIVERY_SERVICEABILITY_PRODUCT_TYPE=B2C

# Delhivery AWB pool (waybill fetch only — separate from Trackon)
DELHIVERY_WAYBILL_AUTH_MODE=both
DELHIVERY_AWB_AUTO_REPLENISH_ENABLED=true
DELHIVERY_AWB_REPLENISH_THRESHOLD=20
DELHIVERY_AWB_REPLENISH_BATCH=50
DELHIVERY_AWB_BULK_COOLDOWN_MS=300000
DELHIVERY_AWB_REPLENISH_LOCK_TTL_MS=300000
DELHIVERY_AWB_BACKGROUND_CHECK_MS=600000

# Optional JSON override for surface/air/prime → Delhivery shipping_mode + transport_speed
# DELHIVERY_SHIPPING_MODE_JSON={"surface":{"supported":true,"shipping_mode":"Surface","transport_speed":"D"}}
# Optional; defaults to MSG91 template namespace configured in the dashboard
MSG91_TEMPLATE_NAMESPACE=

# AiSensy WhatsApp integration (POST /api/public/integrations/aisensy/track,
# GET /api/external/orders/:orderId/complete-details)
# Header: X-Aaysh-Integration-Key
AISENSY_INTEGRATION_API_KEY=
# Company scope for complete-details only (orders must match this companyID)
AISENSY_INTEGRATION_COMPANY_ID=
# Optional rate limit (defaults: 60 requests per 60s per IP+key prefix)
# AISENSY_RATE_LIMIT_WINDOW_MS=60000
# AISENSY_RATE_LIMIT_MAX=60
